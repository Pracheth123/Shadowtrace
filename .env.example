# Copy to .env and fill in. Never commit .env — it is in .gitignore.
# Every value here is a PLACEHOLDER. No real credential belongs in this file.
#
# PRECEDENCE: a variable set in the process environment wins; otherwise the
# value here in .env; otherwise the default in src/interview/config.py.
# config/inference.yaml does NOT override any of these (stage 16).
# Diagnostics without secrets: GET /api/diagnostics, POST /api/diagnostics/verify,
# or `python tools/check_providers.py`.

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=dev                    # dev | test | prod
LOG_LEVEL=INFO
APP_VERSION=0.4.0
GIT_SHA=

# Mock STT/LLM/TTS. Allowed in dev and test; REFUSED at startup when
# APP_ENV=prod, so a missing credential cannot produce a "successful"
# interview out of silence and canned text. With 0 and no GROQ_API_KEY,
# sessions are refused instead of falling back to the plan-based interviewer.
ALLOW_MOCK_PROVIDERS=0

# 1 forces the plan-based (no AI model) interviewer and the placeholder
# evaluator even when GROQ_API_KEY is set. Requires ALLOW_MOCK_PROVIDERS=1.
# Leave unset to follow the key. Everything it produces is labelled as such.
MOCK_LLM=

DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_SESSION_SECONDS=900
MAX_LIVE_SESSIONS=8            # concurrent live sessions
INTAKE_RPH=10                  # intakes per candidate per hour
RESUME_TTL_S=180               # how long a dropped socket can resume

# Guest data not touched for this many days is deleted by a background sweep
# (same routine as "Delete my data"). 0 disables the sweep. Shown to the
# candidate before upload. Copies held by Groq/Deepgram are outside its reach.
GUEST_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_S=3600

# ── Groq — interviewer, indexer, evaluator, roadmap ──────────────────────────
# Server-side only. Never referenced from client/ code.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Verified against Groq's published model list on 2026-10-04. Production ids:
#   openai/gpt-oss-20b, openai/gpt-oss-120b,
#   openai/gpt-oss-20b, openai/gpt-oss-120b
# gemma2-9b-it was RETIRED and is rejected by config validation.
MODEL_LIVE_INTERVIEWER=openai/gpt-oss-20b
MODEL_INDEXER=openai/gpt-oss-20b
MODEL_EVALUATOR=openai/gpt-oss-120b
MODEL_ROADMAP=openai/gpt-oss-120b

# Second model on the SAME provider. Covers a withdrawn or overloaded model.
# It does NOT cover a provider-wide outage — the runtime must still show the
# candidate a degraded state in that case.
# Re-verified 2026-10-06 with an authenticated GET /models: all four ids above
# and below are available to the project's key (tools/check_providers.py).
# Availability is per account; run the check with your own key.
MODEL_FALLBACK_FAST=qwen/qwen3.8-27b
MODEL_FALLBACK_QUALITY=qwen/qwen3.8-27b

# Client-side cap shared by every role on this key. Keep it at or below the
# account's real limit; raising it only converts client waiting into 429s.
# Note: the measured bottleneck on 2026-10-06 was the provider's own 429s
# (Retry-After 16 s), not this limiter — see docs/decisions/stage16_upgrade.md.
GROQ_REQUESTS_PER_MINUTE=30
# RETRIES after the first attempt, per model, for retryable errors only
# (429, 408, 409, 5xx, timeout, connection). Attempts per model = retries + 1.
# The OpenAI SDK's own retries are disabled, so this is the only retry layer.
# On a non-retryable error (or retries exhausted) there is ONE hop to the
# fallback model; authentication errors never fall back.
GROQ_MAX_RETRIES=3
# Per HTTP request timeout: live interviewer calls / evaluator calls.
GROQ_TIMEOUT_S=12.0
GROQ_EVAL_TIMEOUT_S=60.0
# Whole budget for one interviewer decision (limiter wait + retries + fallback).
# When spent, the plan-based proposer asks the next question and the candidate
# is told. Every such turn is recorded in the session's degraded-turn audit.
LIVE_MODEL_DEADLINE_S=10.0
MAX_MODEL_CALLS_PER_TURN=3
STRUCTURED_REPLY_MAX_TOKENS=800

# ── Evaluation budget ────────────────────────────────────────────────────────
# Re-asks after an invalid or truncated evaluator reply (replies = repairs + 1).
# Provider errors are not retried here — the client already did.
EVAL_MAX_REPAIRS=1
EVAL_ROUND_DEADLINE_S=150
EVAL_JOB_DEADLINE_S=240
# Total runs allowed for one round, explicit retries included.
EVAL_MAX_ROUND_RUNS=4
EVAL_MAX_TOKENS=4000

# ── Deepgram — speech to text (default speech provider) ──────────────────────
# Server-side only. The key is sent to Deepgram in an Authorization header by
# the server; it is never placed in a URL, a log line, or any browser message.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_URL=wss://api.deepgram.com/v1/listen

# nova-3 supports `keyterm` prompting. The older `keywords` parameter is
# Nova-2-only and is ignored by nova-3.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# The server converts browser audio and declares exactly what it sends.
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_CHANNELS=1

# Provider default endpointing is 10 ms, which fires on tiny gaps. 300 ms is
# the low end of the documented conversational range.
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# When an answer is over. Deepgram's endpointing / UtteranceEnd fire on a
# breath-length pause, so they only start a silence clock: the answer ends after
# this much silence after the last recognised word, or the longer value when
# the answer sounds unfinished ("...and", "um", a trailing comma, a few words).
# "Done answering" in the room ends it immediately.
ANSWER_END_SILENCE_MS=3000
ANSWER_END_EXTENDED_MS=5000

# UtteranceEnd and SpeechStarted are only delivered when vad_events is on.
DEEPGRAM_VAD_EVENTS=1
DEEPGRAM_INTERIM_RESULTS=1
DEEPGRAM_SMART_FORMAT=1

# Documented budget is 500 tokens across all keyterms; this also caps the count
# so one candidate's claims cannot consume the whole budget.
DEEPGRAM_MAX_KEYTERMS=48

# ── Deepgram — text to speech ────────────────────────────────────────────────
DEEPGRAM_TTS_URL=wss://api.deepgram.com/v1/speak
# Aura-2 is the current generation (aura-2-thalia-en, aura-2-apollo-en,
# aura-2-vesta-en, aura-2-arcas-en, aura-2-orpheus-en, aura-2-andromeda-en).
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=24000
# Provider limit is 20 Flush messages per 60 s; stay under it.
DEEPGRAM_TTS_MAX_FLUSHES_PER_MINUTE=18

# ── Optional: replay a recorded transcript instead of live STT (dev only) ────
# FAKE_STT_PATH=fixtures/transcripts/stage4_session_a.json

# --- Report index database (history, comparisons, recurring gaps, plan) -------
# Empty: SQLite at DATA_DIR/reports.sqlite (development). postgresql://… selects
# PostgreSQL (pip install -r requirements-postgres.txt). Production requires
# PostgreSQL with sslmode=verify-full unless ALLOW_SQLITE_IN_PRODUCTION=1.
# Only this index moves: every other record stays in files under DATA_DIR.
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=5000
# Unset: migrate on startup outside production; production uses
# `python -m interview.storage migrate` with a migration role.
DB_AUTO_MIGRATE=
ALLOW_SQLITE_IN_PRODUCTION=0
# Deletion tombstones; keep outside DATA_DIR in production (see docs/DEPLOYMENT.md).
DELETION_LEDGER_PATH=
