# /etc/shadowtrace/shadowtrace.env — runtime settings for the API service.
# Install as: root:shadowtrace, mode 0640 (install -m 0640 -o root -g shadowtrace).
# Never commit the real file, paste it into a ticket, or put any value in the
# client build. Values in <angle brackets> are yours to fill in on the host.
APP_ENV=prod
ALLOW_MOCK_PROVIDERS=0
LOG_LEVEL=INFO
APP_VERSION=<release version>
GIT_SHA=<set by install_release.sh>

# Exact public origin(s). No wildcards.
ALLOWED_ORIGINS=https://<your-hostname>

# Files (encrypted EBS mounted at /var/lib/shadowtrace).
DATA_DIR=/var/lib/shadowtrace/data
SESSION_LOG_DIR=/var/lib/shadowtrace/logs
REPORT_DIR=/var/lib/shadowtrace/legacy-reports
INTAKE_DIR=/var/lib/shadowtrace/legacy-intake
STORE_PATH=/var/lib/shadowtrace/legacy-longitudinal.sqlite
# Deletion tombstones live OUTSIDE DATA_DIR, so restoring an older DATA_DIR
# backup can never replace them.
DELETION_LEDGER_PATH=/var/lib/shadowtrace/ledger/deletion-ledger.jsonl

# Report index on RDS PostgreSQL, as the least-privilege APP role.
# verify-full checks the server certificate AND hostname against the RDS CA bundle.
# Quoted: systemd strips the quotes, and the deploy scripts source this file with
# bash, where an unquoted & would background the command.
DATABASE_URL='postgresql://shadowtrace_app:<app-password-url-encoded>@<rds-endpoint>:5432/shadowtrace?sslmode=verify-full&sslrootcert=/etc/shadowtrace/rds-ca.pem'
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=5000
# Production never migrates on startup; install_release.sh runs migrations with
# the migration role (/etc/shadowtrace/migrate.env).
DB_AUTO_MIGRATE=0

# Providers (billed by Groq / Deepgram, not AWS).
GROQ_API_KEY=<groq key>
DEEPGRAM_API_KEY=<deepgram key>

# One worker, one host: limits are per process.
MAX_LIVE_SESSIONS=8
MAX_SESSION_SECONDS=1200
SESSION_IDLE_SECONDS=300
SESSION_IDLE_WARNING_S=60
EVAL_CONCURRENCY=3
EVAL_QUEUE_MAX=20
GROQ_REQUESTS_PER_MINUTE=30
# uvicorn already takes the client address from Caddy's X-Forwarded-For
# (--forwarded-allow-ips 127.0.0.1). Leave empty unless another proxy fronts Caddy.
TRUSTED_PROXIES=
GUEST_RETENTION_DAYS=30
